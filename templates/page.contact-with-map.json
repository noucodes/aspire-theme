        "horizontal_content": false,
        "narrow": true,
        "show_divider": false,
        "use_custom_colors": false,
        "colors_text": "#0a0a0a",
        "colors_background": "#ffffff",
        "gradient_background": "",
        "colors_highlight": "#ec6e00",
        "padding_top": 48,
        "padding_bottom": 0,
        "enable_highlight": false,
        "highlight_style": "marker"
