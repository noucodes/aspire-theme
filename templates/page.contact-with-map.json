          "type": "heading",
          "settings": {
            "heading": "Contact Us",
            "heading_size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Get in touch with the Aspire Bathrooms team — we're here to help.</p>",
            "text_size": "typeset2"
          }
        }
      },
      "block_order": ["heading", "text"],
      "settings": {
        "image": "",
        "image_position": "center center",
